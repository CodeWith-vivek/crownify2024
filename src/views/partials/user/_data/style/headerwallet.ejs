        .modal {
            display: none;
            /* Hidden by default */
            position: fixed;
            /* Stay in place */
            z-index: 1;
            /* Sit on top */
            left: 0;
            top: 0;
            width: 100%;
            /* Full width */
            height: 100%;
            /* Full height */
            overflow: auto;
            /* Enable scroll if needed */
            background-color: rgba(84, 79, 79, 0.147);
            /* Fallback color */
            background-color: rgba(165, 154, 154, 0.172);
            /* Black w/ opacity */
        }

