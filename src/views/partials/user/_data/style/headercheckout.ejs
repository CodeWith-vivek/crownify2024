        .image-container {

            position: relative;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        .image-container img {
            cursor: pointer;
            position: absolute;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: opacity 0.3s ease;
            /* Smooth transition */
        }

        .default-image {
            opacity: 1;
            /* Show default image by default */
        }

        .hover-image {
            opacity: 0;
            /* Hide hover image by default */
        }

        .image-container:hover .default-image {


            opacity: 0;
            /* Hide default image on hover */
        }

        .image-container:hover .hover-image {

            transition-duration: 2ms;
            opacity: 1;
            /* Show hover image on hover */
        }

        .image-container:hover {
            cursor: pointer;
        }

