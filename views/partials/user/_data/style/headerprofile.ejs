            }

            .order-detail h4 {
                font-size: 0.9rem;
                /* Smaller headings for order details */
            }
        }

        .order-id {
            font-size: 2.5rem;
            /* Default size for very large screens (desktops) */
            margin-bottom: 10px;
            /* Space below the heading */
        }

        /* Large screens (≥ 992px, e.g., large desktops) */
        @media (min-width: 992px) {
            .order-id {
                font-size: 2rem;
                /* Size for large screens */
            }
        }

        /* Medium screens (≥ 768px and < 992px, e.g., tablets) */
        @media (min-width: 768px) and (max-width: 991px) {
            .order-id {
                font-size: 1.75rem;
                /* Size for medium screens */
            }
        }

        /* Small screens (≥ 576px and < 768px, e.g., small tablets and large phones) */
        @media (min-width: 576px) and (max-width: 767px) {
            .order-id {
                font-size: 1.5rem;
                /* Size for small screens */
                text-align: center;
                /* Center text for better alignment */
            }
        }

        /* Extra small screens (< 576px, e.g., phones) */
        @media (max-width: 575px) {
            .order-id {
                font-size: 1.25rem;
                /* Size for extra small screens */
                text-align: center;
                /* Center text for better alignment */
            }
        }

        /* Very small screens (< 400px, e.g., very small phones) */
        @media (max-width: 400px) {
            .order-id {
                font-size: 1rem;
                /* Size for very small screens */
            }
