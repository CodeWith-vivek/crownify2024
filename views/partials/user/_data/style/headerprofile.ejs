        :root {
            --primary-color: #3498db;
            --secondary-color: #2ecc71;
            --background-color: #f8f9fa;
            --text-color: #333;
            --muted-color: #6c757d;
            --border-color: #e0e0e0;
            --shadow-color: rgba(0, 0, 0, 0.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Inter", sans-serif;
            font-optical-sizing: auto;
            line-height: 1.5;
            color: var(--text-color);
            background-color: var(--background-color);

        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .card {
            background-color: #fff;
            border-radius: 8px;
            box-shadow: 0 4px 6px var(--shadow-color);
            overflow: hidden;
        }

        .card-header {
            background-color: var(--primary-color);
            color: #fff;
            padding: 20px;
        }

        .card-header h5 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 600;
        }

        .card-body {
            padding: 20px;
        }

        .order-list-header {
            display: none;
            font-weight: 600;
            color: var(--muted-color);
            padding: 0 20px 10px;
            border-bottom: 1px solid var(--border-color);
        }

        .order-item {
            background-color: #fff;
            border-radius: 8px;
            margin-bottom: 20px;
            padding: 20px;
            transition: box-shadow 0.3s ease;
        }

        .order-item:hover {
            box-shadow: 0 6px 12px var(--shadow-color);
        }

        .order-content {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 20px;
        }

        .product-info {
            flex: 1;
            min-width: 200px;

            align-items: center;
        }

        .product-image {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 8px;
            margin-right: 15px;
        }

        .product-details h3 {
            font-size: 1.1rem;
            margin-bottom: 5px;
        }

        .product-details p {
            font-size: 0.9rem;
            color: var(--muted-color);
            margin: 2px 0;
        }

        .order-details {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .order-detail {
            flex: 1;
            min-width: 100px;
        }

        .order-detail h4 {
            font-size: 0.9rem;
            color: var(--muted-color);
            margin-bottom: 5px;
        }

        .order-detail p {
            font-size: 1rem;
            font-weight: 600;
        }

        .badge {
            display: inline-block;
            padding: 4px 8px;
            font-size: 0.8rem;
            font-weight: 600;
            border-radius: 20px;
            text-transform: uppercase;
        }

        .badge-pending {
            background-color: #ffeeba;
            color: #856404;
        }

        .badge-shipped {
            background-color: #d4edda;
            color: #155724;
        }

        .btn {
            display: inline-block;
            padding: 8px 16px;
            font-size: 0.9rem;
            font-weight: 600;
            text-align: center;
            text-decoration: none;

            color: #fff;
            border-radius: 4px;
            transition: background-color 0.3s ease;
        }

        .btn:hover {
            background-color: transparent;
        }

        .order-summary {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid var(--border-color);
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
        }

        .summary-row:last-child {
            font-weight: 600;
            font-size: 1.1rem;
            margin-top: 10px;
        }

        @media (min-width: 768px) {
            .order-list-header {
                display: flex;
            }

            .order-list-header>div {
                flex: 1;
            }

            .order-content {
                flex-wrap: nowrap;
            }

            .product-info {}

            .order-details {
                flex: 3;
                justify-content: space-between;
            }

            .order-detail {
                text-align: center;
            }
        }

