<%
  const layout = locals.layout || 'full';
  const assetPrefix = locals.assetPrefix || '';
  const preloaderPrefix = locals.preloaderPrefix !== undefined ? locals.preloaderPrefix : assetPrefix;
  const headProfile = locals.headProfile || 'header';
  const styleProfile = locals.styleProfile || 'header';
  const wishlistLinkStyle = locals.wishlistLinkStyle || '';
  const faqsHref = locals.faqsHref || '/faq';
  const aboutMobileHref = locals.aboutMobileHref || '/About';
  const includeBootstrapBundle = locals.includeBootstrapBundle !== false;
  const bodyExtraPartial = locals.bodyExtraPartial || null;
%><!DOCTYPE html>
<html<%- locals.htmlClass !== undefined ? locals.htmlClass : ' class="no-js"' %> lang="en">



<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>CROWNIFY</title>
    <meta name="description" content="description">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Favicon -->
    <%- include("_data/head/" + headProfile) %>
<style>
<%- include("_data/style/" + styleProfile) %>
</style>
</head>

<% if (layout === 'full') { %>
<body class="template-index belle home12-category">
    <div id="pre-loader">
        <img src="<%= preloaderPrefix %>assets/images/loader.gif" alt="Loading..." />
    </div>
    <div class="pageWrapper" style="background-color: white;">
        <!--Search Form Drawer-->
        <div class="search">
            <div class="search__form">
                <form class="search-bar__form" action="#">
                    <button class="go-btn search__button" type="submit"><i class="icon anm anm-search-l"></i></button>
                    <input class="search__input" type="search" name="q" value="" placeholder="Search entire store..."
                        aria-label="Search" autocomplete="off">
                </form>
                <button type="button" class="search-trigger close-btn"><i class="anm anm-times-l"></i></button>
            </div>
        </div>
        <!--End Search Form Drawer-->
        <!--Top Header-->
        <div class="top-header">
            <div class="container-fluid">
                <div class="row">
                    <div class="<%= locals.topHeaderCol1Class || 'col-sm-4 col-md-4 col-lg-4 d-none d-lg-none d-md-block d-lg-block' %>">
                        <div class="text-center">
                            <p class="top-header_middle-text"> Worldwide Express Shipping</p>
                        </div>
                    </div>
                    <div class="<%= locals.topHeaderCol2Class || 'col-10 col-sm-8 col-md-5 col-lg-4' %>">

                    </div>

                    <div class="<%= locals.topHeaderCol3Class || 'col-2 col-sm-4 col-md-3 col-lg-4 text-right' %> ">
                        <span class="user-menu d-block d-lg-none"><i class="anm anm-user-al"
                                aria-hidden="true"></i></span>
                        <ul class="customer-links list-inline">
                            <% if(locals.user){%>
                                <li><a href="/"><%=locals.user.name.split(' ')[0]%></a></li>
                                <%}else{%>
                            <li><a href="/login">SIGN IN</a></li>
                            <span>/</span>
                            <li><a href="/signup">SIGN UP</a></li>
                                <%}%>
                            <li style="padding-right: 61px;"><a href="<%= faqsHref %>">FAQS</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <!--End Top Header-->
        <!--Header-->
        <div class="header-wrap classicHeader animated d-flex">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <!--Desktop Logo-->
                    <div class="logo col-md-2 col-lg-2 d-none d-lg-block">
                        <a href="/">
                            <img class="logo1" src="<%= assetPrefix %>assets/images/logoCrownify.png"
                                alt="Belle Multipurpose Html Template" title="CROWNIFY" />
                        </a>
                    </div>
                    <!--End Desktop Logo-->
                    <div class="col-2 col-sm-3 col-md-3 col-lg-8">
                        <div class="d-block d-lg-none">
                            <button type="button"
                                class="btn--link site-header__menu js-mobile-nav-toggle mobile-nav--open">
                                <i class="icon anm anm-times-l"></i>
                                <i class="anm anm-bars-r"></i>
                            </button>
                        </div>
                        <!--Desktop Menu-->
                        <nav class="grid__item" id="AccessibleNav"><!-- for mobile -->
                            <ul id="siteNav" class="site-nav medium center hidearrow">
                                <li class="lvl1 parent megamenu"><a href="/">Home <i
                                            class="anm anm-angle-down-l"></i></a>

                                </li>
                                <li class="lvl1 parent megamenu"><a href="/brand">Brand <i class="anm anm-angle-down-l"></i></a>

                                </li>
                                <li class="lvl1 parent megamenu"><a href="/shop">Shop <i
                                            class="anm anm-angle-down-l"></i></a>

                                </li>


                                <li class="lvl1 parent dropdown"><a href="#">Pages <i
                                            class="anm anm-angle-down-l"></i></a>
                                    <ul class="dropdown">

                                        <li><a href="/About" class="site-nav">About Us  </a></li>
                                        <li><a href="/contact" class="site-nav">Contact Us</a></li>
                                        <li><a href="/faq" class="site-nav">FAQs</a></li>


                                    </ul>
                                </li>
                                <li class="lvl1 parent dropdown"><a href="/contact">Contact<i
                                            class="anm anm-angle-down-l"></i></a></li>


                            </ul>
                        </nav>
                        <!--End Desktop Menu-->
                    </div>
                    <!--Mobile Logo-->
                    <div class="col-6 col-sm-6 col-md-6 col-lg-2 d-block d-lg-none mobile-logo">
                        <div class="logo">
                            <a href="/">
                                <img src="<%= assetPrefix %>assets/images/logoCrownify.png" class="logo2"
                                    alt="Belle Multipurpose Html Template" title="CROWNIFY" />
                            </a>
                        </div>
                    </div>
                    <!--Mobile Logo-->
                    <div class="col-4 col-sm-3 col-md-3 col-lg-2 d-flex align-items-center justify-content-end" >

                        <div class="site-header__wishlist">

                                <a href="/wishlist" class="wishlist-trigger" title="Cart"<%- wishlistLinkStyle %>>
                                <i class="icon anm anm-heart-l"></i>
                            <span class="wishlist-count">
                                <%= locals.wishlistCount ? (wishlistCount> 9 ? '10+' : wishlistCount) : '0' %>
                            </span>
                                </a>

                        </div>
                        <div class="site-cart mr-3">
                            <a href="/cart" class="site-header__cart" title="Cart">
                                <i class="icon anm anm-bag-l"></i>
                                <span class="cart-count">
                                    <%= locals.cartCount ? (cartCount> 9 ? '10+' : cartCount) : '0' %>
                                </span>

                            </a>
                        </div>

                        <!-- Conditional Elements -->
                        <% if (locals.user) { %>
                            <div class="dropdown" style="display: inline-block;">
                                <button class="btn dropdown-toggle" type="button" id="userDropdown"
                                    data-bs-toggle="dropdown" aria-expanded="false"<%- locals.userDropdownButtonStyle || '' %>>
                                    <i class="fa-solid fa-user" style="<%= locals.userIconStyle || 'color: #e14141;' %>"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-start" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item" href="/profile"><i class="fa-solid fa-user"></i> Profile</a>
                                    </li>
                                    <li><a class="dropdown-item" href="/wallet"><i class="fa-solid fa-wallet"></i> Wallet</a>
                                    </li>
                                    <li><a class="dropdown-item" href="/orders"><i class="fa-solid fa-box"></i> Orders</a>
<% if (locals.ordersLiClose !== false) { %>                                    </li>
<% } %>
                                    <li><a class="dropdown-item" href="/logout"><i class="fa-solid fa-sign-out-alt"></i>
                                            Logout</a></li>
                                </ul>
                            </div>
                            <% } %>
                    </div>
                </div>
            </div>
        </div>
        <!--End Header-->
        <!--Mobile Menu-->
        <div class="mobile-nav-wrapper" role="navigation">
            <div class="closemobileMenu"><i class="icon anm anm-times-l pull-right"></i> Close Menu</div>
            <ul id="MobileNav" class="mobile-nav">
                <li class="lvl1 parent megamenu"><a href="/">Home <i class="anm anm-plus-l"></i></a>

                </li>
<% if (locals.mobileNavSwapBrandShop) { %>                <li class="lvl1 parent megamenu"><a href="/shop">Shop <i class="anm anm-plus-l"></i></a>

                </li>
                <li class="lvl1 parent megamenu"><a href="/brand"><%= locals.mobileBrandLabel || 'Brand' %> <i class="anm anm-plus-l"></i></a>

                </li>
<% } else { %>                <li class="lvl1 parent megamenu"><a href="/brand"><%= locals.mobileBrandLabel || 'Brand' %> <i class="anm anm-plus-l"></i></a>

                </li>
                <li class="lvl1 parent megamenu"><a href="/shop">Shop <i class="anm anm-plus-l"></i></a>

                </li>
<% } %>
                <li class="lvl1 parent megamenu"><a href="#">Pages <i class="anm anm-plus-l"></i></a>
                    <ul>


                        <li><a href="<%= aboutMobileHref %>" class="site-nav">About Us</a>
                        </li>
                        <li><a href="/contact" class="site-nav">Contact Us</a></li>
                        <li><a href="/faq" class="site-nav">FAQs</a></li>
                    </ul>
                </li>


            </ul>
        </div>
        <!--End Mobile Menu-->

<% if (bodyExtraPartial) { %>
        <%- include(bodyExtraPartial) %>
<% } else { %>
        <div class="container-fluid crownify d-flex justify-content-center align-items-center">
            <img src="<%= assetPrefix %>assets/images/logo/Crownify_logo_text.png" class="custom-logo">

        </div>
<% if (includeBootstrapBundle) { %>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
<% } %>
<% } %>
<% } else if (layout === 'minimal') { %>
<body class="template-index belle home12-category">
    <div class="pageWrapper" style="background-color: white;">
        <div class="container-fluid crownify4 d-flex justify-content-center align-items-center">
            <img src="<%= assetPrefix %>assets/images/logo/Crownify_logo_text.png" class="custom-logo">

        </div>
<% } %>
<%# layout === 'bare': head only, the page itself opens <body> %>
